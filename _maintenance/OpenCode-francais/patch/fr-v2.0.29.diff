diff --git a/packages/app/src/shell/titlebar/atelier-column.tsx b/packages/app/src/shell/titlebar/atelier-column.tsx
new file mode 100644
index 0000000..b8066a3
--- /dev/null
+++ b/packages/app/src/shell/titlebar/atelier-column.tsx
@@ -0,0 +1,89 @@
+// Bottom of the vertical tabs column: workshop status pill, Workshop, Settings and Help.
+// The Workshop is a separate local app (127.0.0.1:4110, or 4111 for the test install on port 4097) that edits the
+// agent configuration; it only answers windows of this agent and local programs.
+import { createSignal, onCleanup, onMount, Show } from "solid-js"
+import { Icon } from "@opencode/ui/icon"
+import { usePlatform } from "@/runtime/platform/platform"
+import { useLanguage } from "@/runtime/i18n/language"
+import { useSettingsDialog } from "@/settings/command"
+
+const rowClass =
+  "flex h-7 w-full shrink-0 items-center gap-1.5 rounded-[6px] ps-1.5 pe-2 text-[13px] leading-4 text-v2-text-text-faint hover:text-v2-text-text-base focus-visible:outline-none"
+
+export function workshopUrl(path: string) {
+  const port = typeof location !== "undefined" && location.port === "4097" ? 4111 : 4110
+  return `http://127.0.0.1:${port}${path}`
+}
+
+export function openWorkshop(page = "") {
+  void fetch(workshopUrl("/ouvrir" + (page ? `?page=${encodeURIComponent(page)}` : "")), { mode: "cors" }).catch(() => {})
+}
+
+type Status = { gpu: "allume" | "eteint" | "inconnu"; prix_heure?: number; ia_locale: "prete" | "arretee" }
+
+export function AtelierColumn() {
+  const platform = usePlatform()
+  const language = useLanguage()
+  const openSettings = useSettingsDialog()
+  const [status, setStatus] = createSignal<Status>()
+
+  const refresh = () =>
+    fetch(workshopUrl("/api/etat-court"), { mode: "cors" })
+      .then((response) => (response.ok ? response.json() : undefined))
+      .then((value) => setStatus(value))
+      .catch(() => setStatus(undefined))
+
+  onMount(() => {
+    void refresh()
+    const timer = setInterval(refresh, 60_000)
+    onCleanup(() => clearInterval(timer))
+  })
+
+  const dot = (on: boolean, warn = false) => (
+    <span
+      class="inline-block size-2 shrink-0 rounded-full"
+      style={{ background: warn ? "#d29922" : on ? "#3fb950" : "#6b6b6b" }}
+      aria-hidden="true"
+    />
+  )
+
+  return (
+    <div data-slot="vertical-tabs-workshop" class="mt-2 flex w-full shrink-0 flex-col gap-0.5 border-t border-v2-border-border-base pt-2">
+      <Show when={status()}>
+        {(value) => (
+          <button type="button" class={rowClass} onClick={() => openWorkshop("modeles")}>
+            {dot(value().gpu === "eteint", value().gpu === "allume")}
+            <span class="min-w-0 truncate">
+              {value().gpu === "allume"
+                ? language.t("sidebar.status.gpu.on", { price: value().prix_heure ?? "?" })
+                : value().gpu === "eteint"
+                  ? language.t("sidebar.status.gpu.off")
+                  : language.t("sidebar.status.gpu.unknown")}
+            </span>
+            {dot(value().ia_locale === "prete")}
+            <span class="min-w-0 truncate">
+              {value().ia_locale === "prete" ? language.t("sidebar.status.local.ready") : language.t("sidebar.status.local.off")}
+            </span>
+          </button>
+        )}
+      </Show>
+      <button type="button" class={rowClass} data-action="vertical-tabs-workshop" onClick={() => openWorkshop()}>
+        <Icon name="outline-sliders" size="small" class="shrink-0" />
+        <span class="min-w-0 truncate">{language.t("sidebar.workshop")}</span>
+      </button>
+      <button type="button" class={rowClass} data-action="vertical-tabs-settings" onClick={() => openSettings()}>
+        <Icon name="settings-gear" size="small" class="shrink-0" />
+        <span class="min-w-0 truncate">{language.t("sidebar.settings")}</span>
+      </button>
+      <button
+        type="button"
+        class={rowClass}
+        data-action="vertical-tabs-help"
+        onClick={() => platform.openExternal("https://opencode.ai/desktop-feedback")}
+      >
+        <Icon name="help" size="small" class="shrink-0" />
+        <span class="min-w-0 truncate">{language.t("sidebar.help")}</span>
+      </button>
+    </div>
+  )
+}
