index 0000000..3637c55
--- /dev/null
+++ b/packages/tui/test/captures-fr.test.tsx
@@ -0,0 +1,92 @@
+// Captures d'ecran (texte) du terminal en francais, avec un faux serveur : aucune vraie donnee.
+import { test } from "bun:test"
+import { appendFileSync, writeFileSync } from "node:fs"
+import { createAppFixture } from "./fixture/app"
+
+const sortie = process.env.CAPTURES ?? "captures-fr.txt"
+const attendre = (ms: number) => new Promise((r) => setTimeout(r, ms))
+
+test("captures du terminal en francais", async () => {
+  writeFileSync(sortie, "")
+  await using setup = await createAppFixture({ width: 120, height: 40 })
+  const k = setup.mockInput
+  await setup.ready
+  await setup.waitForFrame((frame) => frame.includes("ctrl+p"))
+  const capture = async (titre: string) => {
+    await attendre(350)
+    await setup.renderOnce()
+    const lignes = setup.captureCharFrame().split("\n").filter((l) => l.trim())
+    appendFileSync(sortie, `\n===== ${titre} =====\n${lignes.join("\n")}\n`)
+  }
+  const fermer = async () => {
+    k.pressEscape()
+    await attendre(150)
+    k.pressEscape()
+    await attendre(150)
+    for (let i = 0; i < 12; i++) k.pressBackspace()
+    await attendre(150)
+  }
+  const leader = async (touche: string, mod?: { shift?: boolean; ctrl?: boolean; meta?: boolean }) => {
+    k.pressKey("x", { ctrl: true })
+    await attendre(80)
+    k.pressKey(touche, mod)
+  }
+  const descendre = async (n: number) => {
+    for (let i = 0; i < n; i++) k.pressArrow("down")
+  }
+
+  await capture("Accueil")
+
+  k.pressKey("p", { ctrl: true })
+  await capture("Palette de commandes 1")
+  for (let page = 2; page <= 3; page++) {
+    await descendre(12)
+    await capture(`Palette de commandes ${page}`)
+  }
+  await fermer()
+
+  await k.typeText("/")
+  await capture("Commandes / 1")
+  for (let page = 2; page <= 5; page++) {
+    await descendre(10)
+    await capture(`Commandes / ${page}`)
+  }
+  await fermer()
+
+  for (const [touche, titre] of [
+    ["a", "Agents"],
+    ["m", "Modeles"],
+    ["l", "Conversations"],
+    ["s", "Etat"],
+  ] as const) {
+    await leader(touche)
+    await capture(`${titre} (ctrl+x ${touche})`)
+    if (touche === "m") {
+      k.pressKey("a", { ctrl: true })
+      await capture("Modeles : integrations (ctrl+a)")
+    }
+    await fermer()
+  }
+
+  await k.typeText("/settings")
+  k.pressEnter()
+  await capture("Reglages 1")
+  for (let page = 2; page <= 5; page++) {
+    await descendre(10)
+    await capture(`Reglages ${page}`)
+  }
+  await fermer()
+
+  await k.typeText("/themes")
+  k.pressEnter()
+  await capture("Themes")
+  await fermer()
+
+  k.pressKey("k", { ctrl: true, meta: true })
+  await capture("Aide aux raccourcis (ctrl+alt+k)")
+  await fermer()
+
+  k.pressKey("o", { ctrl: true })
+  await capture("Recents (ctrl+o)")
+  await fermer()
+}, 120_000)
